{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekdays",
    "security:minimumReleaseAgeNpm",
    "group:aws-sdk-js-v3Monorepo",
    "group:postcss",
    "group:linters",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "packageRules": [
    {
      "groupName": "pulumi",
      "matchPackageNames": [
        "@pulumi/{/,}**"
      ]
    },
    {
      "groupName": "crawlee",
      "matchPackageNames": [
        "@crawlee/{/,}**"
      ]
    },
    {
      "groupName": "thi.ng",
      "matchPackageNames": [
        "@thi.ng/{/,}**"
      ]
    }
  ]
}
